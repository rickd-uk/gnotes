{
  "name": "gnotes-editor",
  "private": true,
  "scripts": {
    "build:editor": "npm run build:rich && npm run build:vim",
    "test:editor": "node web/spelling.test.mjs",
    "bench:editor": "node tools/benchmark-editor.mjs",
    "build:rich": "esbuild web/rich-editor.js --bundle --minify --format=iife --outfile=public/rich-editor.js",
    "build:vim": "node tools/build-vim-editor.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@replit/codemirror-vim": "6.4.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "codemirror": "6.0.2",
    "marked": "17.0.6"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
