# Install as /etc/gnotes/gnotes.env with mode 0640, owned by root:gnotes.
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=/var/lib/gnotes/gnotes.db
BACKUP_DIRECTORY=/var/backups/gnotes
GNOTES_SECURE_COOKIES=true
GNOTES_SETUP_TOKEN=replace-with-output-from-openssl-rand-hex-32

# Optional Brevo password recovery. Keep the API key private; an empty key disables recovery.
BREVO_API_KEY=
GNOTES_EMAIL_FROM=noreply@rickd.dev
GNOTES_EMAIL_FROM_NAME=gnotes
GNOTES_PUBLIC_URL=https://gnotes.rickd.dev
