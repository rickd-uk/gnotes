#!/usr/bin/env python3
"""Receive a database key on stdin, verify it in RAM, then start gnotes."""
import os
import argparse
import pathlib
import resource
import secrets
import stat
import subprocess
import sys
import time
import urllib.request

KEY_DIRECTORY = pathlib.Path('/run/gnotes/keys')
DATABASE = pathlib.Path.home() / 'apps/gnotes/data/gnotes.db'
TOOL = pathlib.Path.home() / 'apps/gnotes/bin/gnotes-db'


def check_storage(directory=KEY_DIRECTORY):
    swaps = pathlib.Path('/proc/swaps').read_text().strip().splitlines()
    if len(swaps) != 1 or not swaps[0].startswith('Filename'):
        raise ValueError('Host swap must be disabled before accepting a key')
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError('Key storage must be a private directory owned by this account')
    mount = subprocess.run(['findmnt', '--mountpoint', str(directory), '--noheadings', '--output', 'FSTYPE,OPTIONS'],
                           check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True).stdout.strip()
    if not mount.startswith('tmpfs ') or 'noswap' not in mount.split(None, 1)[1].split(','):
        raise ValueError('Key directory is not a verified non-swappable tmpfs mount')


def install_key(encoded, directory=KEY_DIRECTORY, database=DATABASE, tool=TOOL, stage=False):
    text = encoded.strip()
    if len(text) != 64 or any(ch not in b'0123456789abcdefABCDEF' for ch in text):
        raise ValueError('Input must be a generated 256-bit hexadecimal database key')
    if stage:
        if (directory / 'database.key').exists():
            raise ValueError('Initial staging cannot replace an existing key')
        with database.open('rb') as source:
            if source.read(16) != b'SQLite format 3\0':
                raise ValueError('Initial key staging is only allowed before plaintext database migration')
    candidate = directory / ('.candidate-' + secrets.token_hex(12))
    descriptor = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(descriptor, 'wb') as stream:
            stream.write(text + b'\n')
            stream.flush()
            os.fsync(stream.fileno())
        env = {**os.environ, 'GNOTES_VOLATILE_KEY': '1', 'GNOTES_REQUIRE_ENCRYPTION': '1'}
        # CLI output is generic but is suppressed here; never publish exception
        # objects, input, command output, or key contents in the SSH response.
        if stage:
            os.link(candidate, directory / 'database.key')
        else:
            result = subprocess.run([str(tool), 'db', 'verify', '--source', str(database), '--key-file', str(candidate)],
                                    env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, timeout=600)
            if result.returncode:
                raise ValueError('Key did not unlock and verify the database; existing runtime key is unchanged')
            os.replace(candidate, directory / 'database.key')
    finally:
        candidate.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--stage-only', action='store_true', help='initial plaintext migration only; do not start the service')
    args = parser.parse_args()
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    check_storage()
    key = bytearray(sys.stdin.buffer.read(130))
    try:
        install_key(key, stage=args.stage_only)
    finally:
        key[:] = b'\0' * len(key)
    if args.stage_only:
        print('Key staged in volatile storage for initial migration; service configuration and notes are unchanged.')
        return
    subprocess.run(['systemctl', '--user', 'reset-failed', 'gnotes.service'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(['systemctl', '--user', 'start', 'gnotes.service'], check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(30):
        try:
            with urllib.request.urlopen('http://127.0.0.1:8081/api/health', timeout=2) as response:
                if response.status == 200:
                    print('gnotes is unlocked and healthy. The server key exists only in volatile storage.')
                    return
        except OSError:
            pass
        time.sleep(1)
    raise ValueError('Key verified, but gnotes did not become healthy; inspect service status')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        # All ValueErrors above are fixed public messages; avoid printing
        # subprocess or OS exception text that could expose operational details.
        message = str(error) if isinstance(error, ValueError) else 'Unlock failed; check runtime storage and service configuration'
        print('unlock-gnotes-podman: ' + message, file=sys.stderr)
        sys.exit(1)
