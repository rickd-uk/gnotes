#!/bin/sh
set -eu

environment_file="${GNOTES_ENVIRONMENT_FILE:-/etc/gnotes/gnotes.env}"
service_name="${GNOTES_SERVICE:-gnotes.service}"
backup_service="${GNOTES_BACKUP_SERVICE:-gnotes-backup.service}"
backup_timer="${GNOTES_BACKUP_TIMER:-gnotes-backup.timer}"

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

if [ "$(id -u)" -ne 0 ]; then
    fail "run this command with sudo"
fi
[ -r "$environment_file" ] || fail "cannot read $environment_file"

set -a
# The file is root-owned configuration used by systemd and contains shell-style assignments.
# shellcheck disable=SC1090
. "$environment_file"
set +a

database_path="${DATABASE_PATH:-/var/lib/gnotes/gnotes.db}"
backup_directory="${BACKUP_DIRECTORY:-/var/backups/gnotes}"
host="${HOST:-127.0.0.1}"
port="${PORT:-8080}"
health_url="http://${host}:${port}/api/health"

echo "Checking systemd services..."
systemctl is-active --quiet "$service_name" || fail "$service_name is not active"
systemctl is-enabled --quiet "$service_name" || fail "$service_name is not enabled"
systemctl is-enabled --quiet "$backup_timer" || fail "$backup_timer is not enabled"
[ "$(systemctl show --property=Result --value "$backup_service")" = "success" ] || fail "$backup_service last result was not successful"

echo "Checking local application health..."
curl -fsS --max-time 10 "$health_url"
printf '\n'

echo "Checking SQLite integrity..."
[ "$(sqlite3 -batch -noheader "$database_path" 'PRAGMA quick_check;')" = "ok" ] || fail "SQLite quick_check failed"
echo "SQLite quick_check: ok"

echo "Checking backups..."
latest_backup="$(find "$backup_directory" -maxdepth 1 -type f -name 'gnotes-*.db.gz' -printf '%T@ %p\n' | sort -nr | awk 'NR == 1 { sub(/^[^ ]+ /, ""); print; exit }')"
[ -n "$latest_backup" ] || fail "no compressed database backup exists"
now="$(date +%s)"
backup_time="$(stat -c %Y "$latest_backup")"
backup_age="$((now - backup_time))"
[ "$backup_age" -le 172800 ] || fail "latest backup is more than 48 hours old: $latest_backup"
echo "Latest backup: $latest_backup"

echo "Checking Nginx configuration..."
nginx -t

if [ "$#" -gt 0 ]; then
    echo "Checking public application health..."
    curl -fsS --max-time 15 "$1"
    printf '\n'
fi

echo "All gnotes checks passed."
